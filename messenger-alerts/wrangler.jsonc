// The Messenger → WhatsApp alerts Worker. Deployed on its own from this folder
// (Cloudflare "Root directory": messenger-alerts), separate from the לו״ז יומי app.
{
  "name": "messenger-alerts",
  "main": "src/index.js",
  "compatibility_date": "2025-09-01",
  "durable_objects": { "bindings": [{ "name": "ALERTS", "class_name": "AlertsHub" }] },
  "migrations": [{ "tag": "v1", "new_sqlite_classes": ["AlertsHub"] }],
  "observability": { "enabled": true },
  // Keep variables set in the Cloudflare dashboard (like ADMIN_PASSWORD) across deploys.
  "keep_vars": true
}
