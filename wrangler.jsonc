// The לו״ז יומי app, deployed from the repository root (the app itself lives in luz-yomi/).
// The Messenger alerts are a separate Worker with their own config in messenger-alerts/.
{
  "name": "psychic-fishstick",
  "main": "luz-yomi/src/worker.js",
  "compatibility_date": "2025-09-01",
  "assets": { "directory": "./luz-yomi/public", "binding": "ASSETS", "run_worker_first": ["/sounds/*"] },
  "durable_objects": { "bindings": [{ "name": "DEVICE", "class_name": "Device" }] },
  "migrations": [
    { "tag": "v1", "new_sqlite_classes": ["Device"] },
    { "tag": "v2", "new_sqlite_classes": ["AlertsHub"] },
    // The alerts moved to their own Worker (messenger-alerts/), so this one drops the class.
    { "tag": "v3", "deleted_classes": ["AlertsHub"] }
  ],
  "observability": { "enabled": true },
  // Keep variables set in the Cloudflare dashboard (like ADMIN_PASSWORD) across deploys.
  "keep_vars": true
}
